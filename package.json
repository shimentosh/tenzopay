{
  "name": "tenzopay",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build:shared": "npm run build -w @tenzopay/shared",
    "predev": "npm run build:shared",
    "dev": "concurrently -n api,web,admin -c cyan,green,magenta \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:admin\"",
    "dev:api": "npm run dev -w @tenzopay/api",
    "dev:web": "npm run dev -w @tenzopay/web",
    "dev:admin": "npm run dev -w @tenzopay/admin",
    "build": "npm run build:shared && npm run build -w @tenzopay/api && npm run build -w @tenzopay/web && npm run build -w @tenzopay/admin",
    "db:generate": "npm run db:generate -w @tenzopay/api",
    "db:migrate": "npm run db:migrate -w @tenzopay/api",
    "db:seed": "npm run db:seed -w @tenzopay/api",
    "db:studio": "npm run db:studio -w @tenzopay/api",
    "test": "npm run test -w @tenzopay/api",
    "test:watch": "npm run test:watch -w @tenzopay/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.3"
  }
}
